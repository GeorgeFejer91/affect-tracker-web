{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Affect Tracker Desktop",
  "version": "0.1.0",
  "identifier": "io.github.georgefejer91.affecttracker",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm desktop:build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Affect Tracker Desktop",
        "url": "index.html",
        "width": 980,
        "height": 820,
        "minWidth": 680,
        "minHeight": 620,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Science",
    "shortDescription": "Floating valence-arousal tracker with local LSL streaming",
    "longDescription": "A cross-platform offline affect tracker that mirrors the GitHub Pages application and publishes local Lab Streaming Layer streams.",
    "copyright": "Copyright 2026 George Fejer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
