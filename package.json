{
  "name": "affect-tracker-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-only 2D affect tracker inspired by AffectTracker.",
  "scripts": {
    "test": "node --test",
    "test:web": "node --test",
    "serve": "python -m http.server 8000 --directory site",
    "desktop:dev": "vite --config desktop/vite.config.js",
    "desktop:build": "vite build --config desktop/vite.config.js",
    "desktop:preview": "vite preview --config desktop/vite.config.js",
    "desktop:icons": "tauri icon desktop/icons/app-icon.svg -o src-tauri/icons",
    "desktop:bundle": "tauri build --bundles nsis"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "vite": "7.1.3"
  }
}
